.page {
  min-height: 100vh;
  padding: 8px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f2f2f7;
  color: #000;
}

.floating-status {
  position: fixed;
  z-index: 100;
  display: flex;
  align-items: center;
  width: 154px;
  min-height: 56px;
  padding: 8px 12px;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  background: rgba(0, 0, 0, 0.8);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
  transition: box-shadow 0.2s ease, opacity 0.2s ease;
}

.status-dot {
  width: 10px;
  height: 10px;
  flex: 0 0 10px;
  border-radius: 50%;
  background: #ff3b30;
}

.floating-status.connecting .status-dot {
  background: #ff9500;
  animation: pulse 0.8s ease-in-out infinite alternate;
}

.floating-status.connected .status-dot {
  background: #34c759;
}

.status-copy {
  flex: 1;
  min-width: 0;
  margin-left: 8px;
}

.status-title {
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
}

.status-subtitle {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 10px;
  line-height: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-icon {
  margin-left: 8px;
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
}

@keyframes pulse {
  from {
    opacity: 1;
  }
  to {
    opacity: 0.35;
  }
}

.section {
  margin-bottom: 8px;
}

.measurement-banner {
  margin: 8px 0;
  padding: 10px 12px;
  border: 1px solid #d1d1d6;
  border-radius: 8px;
  background: #fff;
}

.measurement-title {
  color: #000;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.measurement-status {
  margin-top: 2px;
  color: #3c3c43;
  font-size: 12px;
  line-height: 18px;
}

.measurement-result {
  margin-top: 6px;
  color: #000;
  font-size: 13px;
  line-height: 20px;
}

.section-title {
  height: 40px;
  padding: 0 8px;
  color: #3c3c43;
  font-size: 15px;
  font-weight: 600;
  line-height: 40px;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.function-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76px;
  margin: 0;
  padding: 16px 8px;
  box-sizing: border-box;
  border: 1px solid #d1d1d6;
  border-radius: 8px;
  background: #fff;
  color: #000;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  text-align: center;
}

.function-card::after {
  border: 0;
}

.function-card[disabled] {
  color: #8e8e93;
  background: #fafafa;
}

.link-mark {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 14px;
  height: 14px;
  border: 2px solid #007aff;
  border-radius: 50%;
  box-sizing: border-box;
}

.dialog-mask {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.config-dialog {
  width: 100%;
  max-width: 360px;
  max-height: 86vh;
  overflow-y: auto;
  padding: 18px 16px 16px;
  box-sizing: border-box;
  border-radius: 12px;
  background: #fff;
}

.dialog-title {
  color: #000;
  font-size: 18px;
  font-weight: 600;
  line-height: 26px;
  text-align: center;
}

.dialog-desc {
  margin-top: 6px;
  color: #636366;
  font-size: 12px;
  line-height: 18px;
  overflow-wrap: anywhere;
  text-align: left;
}

.dialog-field {
  margin-top: 14px;
}

.field-label {
  margin-bottom: 6px;
  color: #1c1c1e;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
}

.dialog-input {
  height: 42px;
  width: 100%;
  padding: 0 10px;
  box-sizing: border-box;
  border-radius: 8px;
  background: #f2f2f7;
  color: #000;
  font-size: 14px;
}

.picker-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 96px;
  gap: 8px;
}

.choice-list {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.choice-button {
  display: block;
  margin: 0;
  padding: 12px;
  box-sizing: border-box;
  border: 1px solid #d1d1d6;
  border-radius: 8px;
  background: #f8f8fb;
  text-align: left;
}

.choice-button::after {
  border: 0;
}

.choice-button.selected {
  border-color: #007aff;
  background: #eef6ff;
}

.choice-title {
  color: #000;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.choice-desc {
  margin-top: 4px;
  color: #636366;
  font-size: 12px;
  line-height: 18px;
}

.picker-value {
  height: 42px;
  overflow: hidden;
  padding: 0 10px;
  box-sizing: border-box;
  border-radius: 8px;
  background: #f2f2f7;
  color: #000;
  font-size: 14px;
  line-height: 42px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-text {
  margin-top: 12px;
  color: #636366;
  font-size: 12px;
  line-height: 18px;
}

.dialog-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.dialog-button {
  height: 44px;
  margin: 0;
  border-radius: 22px;
  font-size: 15px;
  line-height: 44px;
}

.dialog-button::after {
  border: 0;
}

.dialog-button.secondary {
  background: #e5e5ea;
  color: #3c3c43;
}

.dialog-button.primary {
  background: #007aff;
  color: #fff;
}

@media (min-width: 520px) {
  .page {
    padding: 12px;
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
  }

  .function-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .function-card {
    min-height: 72px;
  }

  .config-dialog {
    max-width: 420px;
  }
}

@media (max-width: 340px) {
  .floating-status {
    width: 136px;
    padding: 7px 10px;
  }

  .status-icon {
    display: none;
  }

  .function-grid {
    grid-template-columns: 1fr;
  }

  .function-card {
    min-height: 58px;
    padding: 12px 8px;
  }

  .picker-row {
    grid-template-columns: 1fr;
  }

  .dialog-actions {
    gap: 8px;
  }
}
