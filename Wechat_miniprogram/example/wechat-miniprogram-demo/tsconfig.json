{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@bcl/ring-adapter-wechat": ["../../packages/adapter-wechat/src/index.ts"],
