<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:fitsSystemWindows="true"
    tools:context=".activity.AivelaProtocolActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@color/colorPrimary">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="aivela定制协议"
            android:textSize="18sp"
            android:layout_centerInParent="true"
            android:textColor="@color/white"/>
        <TextView
            android:id="@+id/tv_cmd_log_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看日志"
            android:textSize="14sp"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:textColor="@color/white"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:text="数据区域"
        android:scrollbars="vertical"
        android:padding="10dp"
        android:lineSpacingExtra="5dp"
        android:textSize="14sp"
        android:textColor="@color/colorPrimaryDark"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <!-- ==================== 一、操作本地数据（cmd=0x36）==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:padding="5dp"
                android:text="一、操作本地数据（0x36）"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- 时间戳输入（历史记录/Gomore睡眠共用） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开始时间戳:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_start_ts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="秒，0为全部"
                    android:text="0"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束时间戳:"
                    android:textSize="12sp"
                    android:layout_marginLeft="5dp"/>
                <EditText
                    android:id="@+id/et_end_ts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="秒"
                    android:text="0"
                    android:inputType="number"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 历史记录数据类型输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据类型:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_data_type"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="0心率1HRV2血氧3体温4步数5久坐6压力7呼吸率"
                    android:text="0"
                    android:inputType="number"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 历史记录按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_read_unuploaded_history"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="读未上传历史(0x25)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_read_all_history"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="读全部历史(0x26)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_get_gomore_sleep"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Gomore睡眠(0x05)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- ==================== 二、系统设置（cmd=0x37）==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/colorPrimary"
                android:padding="5dp"
                android:text="二、系统设置（0x37）"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- 久坐提醒输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周几:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_weekday"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="0-6周日-周六"
                    android:text="1"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="体力值:"
                    android:textSize="12sp"
                    android:layout_marginLeft="5dp"/>
                <EditText
                    android:id="@+id/et_stamina"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="10-100"
                    android:text="50"
                    android:inputType="numberDecimal"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 久坐提醒配置组输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="久坐配置:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_sedentary_groups"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="类型,开始分钟,结束分钟;多组分号隔开"
                    android:text="2,540,720;2,840,1080"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 久坐提醒按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_set_sedentary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="设置久坐提醒(0x2D)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_get_sedentary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="获取久坐提醒(0x2E)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
                <Button
                    android:id="@+id/bt_set_stamina"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="设置体力值(0x2F)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 长睡时间输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="长睡开始小时:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_long_sleep_start"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="0-23"
                    android:text="22"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束小时:"
                    android:textSize="12sp"
                    android:layout_marginLeft="5dp"/>
                <EditText
                    android:id="@+id/et_long_sleep_end"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="0-23"
                    android:text="7"
                    android:inputType="number"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 长睡算法参数输入（计步初始阈值+PPG周期测量时长） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="计步阈值:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_step_threshold"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="2-20"
                    android:text="10"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PPG时长(秒):"
                    android:textSize="12sp"
                    android:layout_marginLeft="5dp"/>
                <EditText
                    android:id="@+id/et_ppg_measure_sec"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="20-240"
                    android:text="120"
                    android:inputType="number"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/bt_set_long_sleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="设置长睡(0x30)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- ==================== 三、运动模式（cmd=0x38）==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/colorPrimary"
                android:padding="5dp"
                android:text="三、运动模式（0x38）"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_set_sport_status_listener"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="设置运动状态监听(0x38/0x07)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- ==================== 四、女性健康相关（cmd=0xC0）==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/colorPrimary"
                android:padding="5dp"
                android:text="四、女性健康相关（0xC0）"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <!-- 周期时间戳数组输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="周期开始:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_menstrual_starts"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="秒,逗号隔开"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结束:"
                    android:textSize="12sp"
                    android:layout_marginLeft="5dp"/>
                <EditText
                    android:id="@+id/et_menstrual_ends"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="秒,逗号隔开"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/bt_write_menstrual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="写入周期(0x00)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

            <!-- 获取预测输入 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="月经周期天数:"
                    android:textSize="12sp"/>
                <EditText
                    android:id="@+id/et_cycle_days"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="13-60，-128重复之前"
                    android:text="28"
                    android:inputType="numberSigned"
                    android:textSize="12sp"/>
                <Button
                    android:id="@+id/bt_get_menstrual_prediction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="获取预测(0x01)"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg_state"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
